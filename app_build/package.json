    "@types/bun": "latest",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/yaml": "1.9.7",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.67.0"
  }
